<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0b0e14</item>
        <item name="android:colorAccent">#8b5cf6</item>
        <item name="android:navigationBarColor">#090b10</item>
        <item name="android:statusBarColor">#0b0e14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase"/>
    <style name="AppThemeLightBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#faf9ff</item>
        <item name="android:colorAccent">#7142c6</item>
        <item name="android:navigationBarColor">#f6f5fc</item>
        <item name="android:statusBarColor">#faf9ff</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeLight" parent="AppThemeLightBase"/>
</resources>
